# ── Everything below is OPTIONAL. ──────────────────────────────────────────
# The app runs with zero env vars: in-memory demo data, one-click demo login,
# and a keyword-based AI fallback. Add these one at a time to move each part
# of the app from "demo mode" to "real mode" — the app keeps working at every
# step in between.

# ── Database (Supabase Postgres, or any Postgres) ──────────────────────────
# Unset: uses the in-memory demo store (seeded with Elda + Petrer).
# Set: real Postgres persistence via Drizzle. Run `npm run db:push` then
# `npm run db:seed` after setting this.
DATABASE_URL=

# ── Auth (Supabase) ─────────────────────────────────────────────────────────
# Unset: one-click demo login (no real identity, cookie-based session).
# Set both: real Google/Apple/email login via Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Anthropic) ──────────────────────────────────────────────────────────
# Unset: keyword-based heuristic categorizer/refiner (still fully functional).
# Set: real AI refinement, categorization, and admin summaries via Claude.
ANTHROPIC_API_KEY=

# ── Anti-abuse (Cloudflare Turnstile) ───────────────────────────────────────
# Unset: rate limiting still applies, but no CAPTCHA challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Admin ────────────────────────────────────────────────────────────────
# Shared demo password for the /admin login page (MVP; not per-town roles yet).
ADMIN_DEMO_PASSWORD=townhall-demo

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
